{
  "name": "meta4services/cloud-services-sdk",
  "description": "PHP SDK para integração com a Cloud Services API focado em operações de arquivos.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "cloud-services",
    "sdk",
    "php",
    "api",
    "files",
    "guzzle"
  ],
  "homepage": "https://github.com/Digidata-Dev-Apps/meta4services-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Digidata-Dev-Apps/meta4services-sdk.git"
  },
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.11",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Meta4Services\\CloudServices\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Meta4Services\\CloudServices\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src tests --level=8",
    "lint": "phpcs --standard=PSR12 src tests"
  },
  "config": {
    "sort-packages": true
  }
}
